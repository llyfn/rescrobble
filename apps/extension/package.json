    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
