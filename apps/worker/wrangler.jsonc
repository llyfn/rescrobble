{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rescrobble",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Browser navigations (the Last.fm callback among them) would otherwise get the Web App page instead of the Worker.
    "run_worker_first": ["/api/*", "/api", "/auth/*", "/auth", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIMITS", "class_name": "AccountLimits" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountLimits"] }],
  "vars": {
    "PUBLIC_BASE_URL": "https://rescrobble.llyfn.workers.dev",
    "EXTENSION_ID": "pjeamaekcjcngmbldpkhanpmgnhjfboh"
  },
  "env": {
    "test": {
      "assets": {
        "directory": "test/web",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/api", "/auth/*", "/auth", "/health"]
      },
      "durable_objects": {
        "bindings": [{ "name": "LIMITS", "class_name": "AccountLimits" }]
      }
    }
  }
}
